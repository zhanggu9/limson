# Backtester 환경변수 예시
# 복사: cp .env.example .env
# 실제 비밀번호는 .env에만 입력하고 GitHub에 커밋하지 마세요.

MCP_PORT=3846
MCP_HOST=127.0.0.1
LEAN_WORKSPACE=/tmp/lean_workspace

# 원격 PostgreSQL 연결 정보 (실제 비밀번호로 교체)
DATABASE_URL=postgresql://admin:YOUR_PASSWORD@43.202.161.134:55432/admin

# 실제 DB 스키마: public.ohlcv
PG_OHLCV_TABLE=public.ohlcv
PG_SYMBOL_COLUMN=ticker_code
PG_DATE_COLUMN=trade_date
PG_OPEN_COLUMN=open
PG_HIGH_COLUMN=high
PG_LOW_COLUMN=low
PG_CLOSE_COLUMN=close
PG_VOLUME_COLUMN=volume

# 분봉 백테스트: pg-stock-api 의 1분봉 테이블 (한 행 = 한 종목의 하루치 분봉 배열)
PG_MINUTE_TABLE=public.ohlcv_minute_day
# 한 번에 처리할 최대 봉 수 (종목 수 × 영업일 × 하루 봉 수), LEAN 실행 제한 시간(초)
MINUTE_BACKTEST_MAX_BARS=1500000
MINUTE_LEAN_TIMEOUT=840
