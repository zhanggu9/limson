{
  "title": "LIMSON 발표",
  "slides": [
    {
      "id": "opt-a",
      "title": "내 전략에 맞는 숫자, 누가 찾아 주지?",
      "html": "<section id=\"opt-a\" data-transition=\"fade\" style=\"background:#0E1726;color:#EDEBE4;font-family:'Noto Sans KR', Arial, sans-serif;padding:128px;display:flex;flex-direction:column;justify-content:space-between;gap:36px\">\n<p style=\"font-size:24px;font-weight:700;letter-spacing:2px;color:#F2B13C\">문제 의식</p>\n<h1 style=\"font-size:64px;font-weight:700;line-height:1.2;color:#EDEBE4\">내 전략에 맞는 숫자, 누가 찾아 주지?</h1>\n<div style=\"display:flex;justify-content:space-between;align-items:center\">\n<div style=\"width:480px;display:flex;flex-direction:column;gap:20px;background:#18243A;padding:32px;border-radius:20px\">\n<h3 style=\"font-size:28px;font-weight:700;line-height:1.25;color:#A9B4C6\">내 전략 · 숫자는 미정</h3>\n<div style=\"display:flex;flex-direction:column;gap:8px\">\n<div style=\"display:flex;justify-content:space-between;align-items:center\">\n<p style=\"font-size:26px;line-height:1.4;color:#EDEBE4\">이동평균 기간</p>\n<p style=\"font-size:26px;font-weight:700;line-height:1.4;color:#A9B4C6\">?</p>\n</div>\n<div style=\"position:relative;width:416px;height:28px\">\n<div style=\"position:absolute;left:0px;top:10px;width:416px;height:8px;background:#2A3A57;border-radius:4px\"></div>\n<x-shape kind=\"ellipse\" style=\"position:absolute;left:60px;top:0px;width:28px;height:28px;background:#A9B4C6\"></x-shape>\n</div>\n</div>\n<div style=\"display:flex;flex-direction:column;gap:8px\">\n<div style=\"display:flex;justify-content:space-between;align-items:center\">\n<p style=\"font-size:26px;line-height:1.4;color:#EDEBE4\">RSI 기준</p>\n<p style=\"font-size:26px;font-weight:700;line-height:1.4;color:#A9B4C6\">?</p>\n</div>\n<div style=\"position:relative;width:416px;height:28px\">\n<div style=\"position:absolute;left:0px;top:10px;width:416px;height:8px;background:#2A3A57;border-radius:4px\"></div>\n<x-shape kind=\"ellipse\" style=\"position:absolute;left:250px;top:0px;width:28px;height:28px;background:#A9B4C6\"></x-shape>\n</div>\n</div>\n<div style=\"display:flex;flex-direction:column;gap:8px\">\n<div style=\"display:flex;justify-content:space-between;align-items:center\">\n<p style=\"font-size:26px;line-height:1.4;color:#EDEBE4\">손절 폭</p>\n<p style=\"font-size:26px;font-weight:700;line-height:1.4;color:#A9B4C6\">?</p>\n</div>\n<div style=\"position:relative;width:416px;height:28px\">\n<div style=\"position:absolute;left:0px;top:10px;width:416px;height:8px;background:#2A3A57;border-radius:4px\"></div>\n<x-shape kind=\"ellipse\" style=\"position:absolute;left:150px;top:0px;width:28px;height:28px;background:#A9B4C6\"></x-shape>\n</div>\n</div>\n</div>\n<x-shape kind=\"arrow-right\" style=\"background:#F2B13C;width:56px;height:28px\"></x-shape>\n<div style=\"width:440px;display:flex;flex-direction:column;align-items:center;gap:16px\">\n<svg aria-label=\"가슴 화면에 오르는 차트를 띄운 로봇\" width=\"300\" height=\"300\" viewBox=\"0 0 300 300\">\n<line x1=\"150\" y1=\"40\" x2=\"150\" y2=\"18\" stroke=\"#A9B4C6\" stroke-width=\"6\" stroke-linecap=\"round\"/>\n<circle cx=\"150\" cy=\"16\" r=\"10\" fill=\"#F2B13C\"/>\n<rect x=\"70\" y=\"40\" width=\"160\" height=\"110\" rx=\"28\" fill=\"#EDEBE4\"/>\n<rect x=\"88\" y=\"62\" width=\"124\" height=\"60\" rx=\"18\" fill=\"#0E1726\"/>\n<circle cx=\"122\" cy=\"92\" r=\"12\" fill=\"#F2B13C\"/>\n<circle cx=\"178\" cy=\"92\" r=\"12\" fill=\"#F2B13C\"/>\n<rect x=\"52\" y=\"78\" width=\"18\" height=\"36\" rx=\"8\" fill=\"#A9B4C6\"/>\n<rect x=\"230\" y=\"78\" width=\"18\" height=\"36\" rx=\"8\" fill=\"#A9B4C6\"/>\n<rect x=\"132\" y=\"150\" width=\"36\" height=\"16\" fill=\"#A9B4C6\"/>\n<rect x=\"60\" y=\"166\" width=\"180\" height=\"120\" rx=\"26\" fill=\"#EDEBE4\"/>\n<rect x=\"82\" y=\"186\" width=\"136\" height=\"80\" rx=\"12\" fill=\"#0E1726\"/>\n<polyline points=\"94,250 118,232 140,240 166,212 188,220 206,198\" fill=\"none\" stroke=\"#F2B13C\" stroke-width=\"6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n<circle cx=\"206\" cy=\"198\" r=\"7\" fill=\"#F2B13C\"/>\n<rect x=\"28\" y=\"180\" width=\"32\" height=\"76\" rx=\"14\" fill=\"#A9B4C6\"/>\n<rect x=\"240\" y=\"180\" width=\"32\" height=\"76\" rx=\"14\" fill=\"#A9B4C6\"/>\n</svg>\n<p style=\"font-size:24px;line-height:1.4;text-align:center;color:#A9B4C6\">여러 조합을 대신 돌려 보고 비교</p>\n</div>\n<x-shape kind=\"arrow-right\" style=\"background:#F2B13C;width:56px;height:28px\"></x-shape>\n<div style=\"width:480px;display:flex;flex-direction:column;gap:20px;background:#18243A;padding:32px;border:2px solid #F2B13C;border-radius:20px\">\n<h3 style=\"font-size:28px;font-weight:700;line-height:1.25;color:#F2B13C\">찾아낸 값 (예시)</h3>\n<div style=\"display:flex;flex-direction:column;gap:8px\">\n<div style=\"display:flex;justify-content:space-between;align-items:center\">\n<p style=\"font-size:26px;line-height:1.4;color:#EDEBE4\">이동평균 기간</p>\n<p style=\"font-size:26px;font-weight:700;line-height:1.4;color:#F2B13C\">20일</p>\n</div>\n<div style=\"position:relative;width:412px;height:28px\">\n<div style=\"position:absolute;left:0px;top:10px;width:412px;height:8px;background:#2A3A57;border-radius:4px\"></div>\n<x-shape kind=\"ellipse\" style=\"position:absolute;left:110px;top:0px;width:28px;height:28px;background:#F2B13C\"></x-shape>\n</div>\n</div>\n<div style=\"display:flex;flex-direction:column;gap:8px\">\n<div style=\"display:flex;justify-content:space-between;align-items:center\">\n<p style=\"font-size:26px;line-height:1.4;color:#EDEBE4\">RSI 기준</p>\n<p style=\"font-size:26px;font-weight:700;line-height:1.4;color:#F2B13C\">30</p>\n</div>\n<div style=\"position:relative;width:412px;height:28px\">\n<div style=\"position:absolute;left:0px;top:10px;width:412px;height:8px;background:#2A3A57;border-radius:4px\"></div>\n<x-shape kind=\"ellipse\" style=\"position:absolute;left:290px;top:0px;width:28px;height:28px;background:#F2B13C\"></x-shape>\n</div>\n</div>\n<div style=\"display:flex;flex-direction:column;gap:8px\">\n<div style=\"display:flex;justify-content:space-between;align-items:center\">\n<p style=\"font-size:26px;line-height:1.4;color:#EDEBE4\">손절 폭</p>\n<p style=\"font-size:26px;font-weight:700;line-height:1.4;color:#F2B13C\">-3%</p>\n</div>\n<div style=\"position:relative;width:412px;height:28px\">\n<div style=\"position:absolute;left:0px;top:10px;width:412px;height:8px;background:#2A3A57;border-radius:4px\"></div>\n<x-shape kind=\"ellipse\" style=\"position:absolute;left:200px;top:0px;width:28px;height:28px;background:#F2B13C\"></x-shape>\n</div>\n</div>\n</div>\n</div>\n<div style=\"display:flex;flex-direction:column;background:#F2B13C;padding:28px 40px;border-radius:16px\">\n<p style=\"font-size:36px;font-weight:700;line-height:1.3;color:#0E1726\">LIMSON = 내가 원하는 전략의 파라미터값을 알아서 찾아주는 로보어드바이저</p>\n</div>\n</section>",
      "notes": "전략 아이디어는 제가 정할 수 있습니다. 그런데 이동평균을 며칠로 할지, RSI 기준을 몇으로 할지, 손절은 몇 퍼센트로 할지 같은 숫자는 정하기 어렵습니다. 그래서 이 숫자를 대신 찾아 주는 로보어드바이저를 만들고 싶었습니다. LIMSON은 여러 조합을 과거 데이터로 대신 돌려 보고, 가장 좋은 값을 찾아 줍니다. 화면의 20일, 30, -3%는 이해를 돕기 위한 예시 숫자입니다."
    },
    {
      "id": "arch",
      "title": "화면은 클라우드에서, 무거운 계산은 내 PC에서",
      "html": "<section id=\"arch\" data-transition=\"fade\" style=\"background:#F5F3EC;color:#0E1726;font-family:'Noto Sans KR', Arial, sans-serif;padding:128px 128px 160px;display:flex;flex-direction:column;justify-content:space-between;gap:32px\">\n<p style=\"font-size:24px;font-weight:700;letter-spacing:2px;color:#8A5D00\">구조</p>\n<h2 style=\"font-size:60px;font-weight:700;line-height:1.2;color:#0E1726\">화면은 클라우드에서, 무거운 계산은 내 PC에서</h2>\n<div style=\"display:flex;gap:24px;align-items:stretch\">\n<div style=\"width:240px;display:flex;flex-direction:column;justify-content:center;gap:12px;background:#FFFFFF;padding:24px;border:1px solid #D9D5C8;border-radius:16px\">\n<svg data-icon=\"Globe\" aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"color:#8A5D00;width:40px;height:40px;flex-shrink:0\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"/><path d=\"M2 12h20\"/></svg>\n<h3 style=\"font-size:28px;font-weight:700;line-height:1.25;color:#0E1726\">브라우저</h3>\n<p style=\"font-size:24px;line-height:1.45;color:#4A5568\">어디서나 주소 하나로 접속</p>\n</div>\n<div style=\"width:64px;display:flex;flex-direction:column;justify-content:center;align-items:center\">\n<x-shape kind=\"arrow-right\" style=\"background:#F2B13C;width:56px;height:28px\"></x-shape>\n</div>\n<div style=\"width:660px;display:flex;flex-direction:column;gap:16px;background:#FFFFFF;padding:28px;border:1px solid #D9D5C8;border-radius:16px\">\n<h3 style=\"font-size:28px;font-weight:700;line-height:1.25;color:#8A5D00\">클라우드 · AWS EC2 (1GB 서버)</h3>\n<div style=\"display:flex;flex-direction:column;background:#F5F3EC;padding:18px 20px;border-radius:12px\">\n<p style=\"font-size:24px;line-height:1.45;color:#0E1726\"><b>nginx</b> · 입구 하나 (HTTPS · 로그인)</p>\n</div>\n<div style=\"display:flex;gap:16px\">\n<div style=\"flex:1;display:flex;flex-direction:column;gap:6px;background:#F5F3EC;padding:18px 20px;border-radius:12px\">\n<h3 style=\"font-size:28px;font-weight:700;line-height:1.25;color:#0E1726\">전략 빌더</h3>\n<p style=\"font-size:24px;line-height:1.45;color:#4A5568\">웹에서 전략 만들기</p>\n</div>\n<div style=\"flex:1;display:flex;flex-direction:column;gap:6px;background:#F5F3EC;padding:18px 20px;border-radius:12px\">\n<h3 style=\"font-size:28px;font-weight:700;line-height:1.25;color:#0E1726\">백테스트 화면</h3>\n<p style=\"font-size:24px;line-height:1.45;color:#4A5568\">결과와 차트 보기</p>\n</div>\n</div>\n<div style=\"display:flex;flex-direction:column;gap:6px;background:#F5F3EC;padding:18px 20px;border-radius:12px\">\n<h3 style=\"font-size:28px;font-weight:700;line-height:1.25;color:#0E1726\">PostgreSQL</h3>\n<p style=\"font-size:24px;line-height:1.45;color:#4A5568\">직접 모은 일봉 · 분봉 데이터</p>\n</div>\n</div>\n<div style=\"width:120px;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:12px\">\n<p style=\"font-size:24px;font-weight:700;line-height:1.3;text-align:center;color:#8A5D00\">SSH 역터널</p>\n<x-shape kind=\"arrow-right\" style=\"background:#F2B13C;width:56px;height:28px\"></x-shape>\n</div>\n<div style=\"width:460px;display:flex;flex-direction:column;gap:16px;background:#0E1726;padding:28px;border-radius:16px\">\n<h3 style=\"font-size:28px;font-weight:700;line-height:1.25;color:#F2B13C\">내 PC · 로컬 워커</h3>\n<div style=\"display:flex;flex-direction:column;gap:6px;background:#18243A;padding:18px 20px;border-radius:12px\">\n<h3 style=\"font-size:28px;font-weight:700;line-height:1.25;color:#EDEBE4\">백테스트 API</h3>\n<p style=\"font-size:24px;line-height:1.45;color:#A9B4C6\">요청을 받아 실행</p>\n</div>\n<div style=\"display:flex;flex-direction:column;gap:6px;background:#18243A;padding:18px 20px;border-radius:12px\">\n<h3 style=\"font-size:28px;font-weight:700;line-height:1.25;color:#EDEBE4\">Docker LEAN 엔진</h3>\n<p style=\"font-size:24px;line-height:1.45;color:#A9B4C6\">백테스트 · 하이퍼옵트 계산</p>\n</div>\n<div style=\"flex:1\"></div>\n<p style=\"font-size:24px;line-height:1.45;color:#A9B4C6\">엔진이 42GB라서 작은 서버에는 못 올린다</p>\n</div>\n</div>\n<p style=\"font-size:32px;font-weight:500;line-height:1.4;color:#0E1726\">작은 서버 한 대 값으로, 누구나 웹에서 쓰는 백테스트 환경</p>\n<p style=\"position:absolute;left:128px;bottom:64px;width:1664px;font-size:24px;color:#4A5568\">주문 신호는 전략 빌더에서 한국투자증권 Open API(모의투자)로 보낸다</p>\n</section>",
      "notes": "구조는 크게 두 덩어리입니다. 왼쪽은 클라우드, 오른쪽은 제 PC입니다. 사용자는 브라우저로 주소 하나에 접속합니다. 클라우드 서버에는 입구 역할을 하는 nginx, 전략을 만드는 전략 빌더, 결과를 보는 백테스트 화면, 그리고 제가 직접 모은 주가 데이터가 들어 있습니다. 그런데 백테스트 엔진인 LEAN은 42GB나 돼서 메모리 1GB짜리 서버에서는 돌릴 수 없습니다. 그래서 무거운 계산은 제 PC에서 하고, 둘을 SSH 역터널이라는 통로로 연결했습니다. 연결이 끊기면 5초마다 자동으로 다시 붙습니다. 시연에 앞서, 이 엔진으로 돌리는 하이퍼옵트가 무엇인지 먼저 설명하겠습니다."
    },
    {
      "id": "hyperopt",
      "title": "하이퍼옵트: 설정값 맞추기를 로봇에게 맡긴다",
      "html": "<section id=\"hyperopt\" data-transition=\"fade\" style=\"background:#0E1726;color:#EDEBE4;font-family:'Noto Sans KR', Arial, sans-serif;padding:128px;display:flex;flex-direction:column;justify-content:space-between;gap:30px\">\n<p style=\"font-size:24px;font-weight:700;letter-spacing:2px;color:#F2B13C\">하이퍼파라미터 튜닝 · 하이퍼옵트</p>\n<h2 style=\"font-size:60px;font-weight:700;line-height:1.2;color:#EDEBE4\">하이퍼옵트: 설정값 맞추기를 로봇에게 맡긴다</h2>\n<div style=\"display:flex;justify-content:space-between;align-items:stretch\">\n<div style=\"width:520px;display:flex;flex-direction:column;justify-content:space-between;gap:14px;background:#EDEBE4;padding:32px;border-radius:20px\">\n<h3 style=\"font-size:30px;font-weight:700;line-height:1.25;color:#8A5D00\">하이퍼파라미터란?</h3>\n<p style=\"font-size:26px;line-height:1.4;color:#0E1726\">전략을 돌리기 전에 사람이 미리 정해 줘야 하는 설정값</p>\n<div style=\"display:flex;gap:10px\">\n<p style=\"font-size:24px;font-weight:700;line-height:1.4;color:#0E1726;background:#F2B13C;padding:6px 12px;border-radius:24px\">이동평균 기간</p>\n<p style=\"font-size:24px;font-weight:700;line-height:1.4;color:#0E1726;background:#F2B13C;padding:6px 12px;border-radius:24px\">RSI 기준</p>\n<p style=\"font-size:24px;font-weight:700;line-height:1.4;color:#0E1726;background:#F2B13C;padding:6px 12px;border-radius:24px\">손절 폭</p>\n</div>\n<h3 style=\"font-size:30px;font-weight:700;line-height:1.25;color:#8A5D00\">튜닝이란?</h3>\n<p style=\"font-size:26px;line-height:1.4;color:#0E1726\">가장 좋은 결과가 나오게 그 값을 맞추는 일</p>\n<p style=\"font-size:24px;line-height:1.4;color:#4A5568\">라면으로 치면 물의 양과 끓이는 시간</p>\n</div>\n<div style=\"display:grid;grid-template-columns:440px 200px 440px;gap:12px;align-items:center\">\n<div style=\"display:flex;gap:16px;align-items:center;background:#18243A;padding:24px;border-radius:16px\">\n<p style=\"width:48px;font-size:26px;font-weight:700;line-height:1.4;text-align:center;color:#0E1726;background:#F2B13C;padding:6px 0px;border-radius:50%\">1</p>\n<div style=\"display:flex;flex-direction:column;gap:6px\">\n<h3 style=\"font-size:28px;font-weight:700;line-height:1.25;color:#EDEBE4\">값 고르기</h3>\n<p style=\"font-size:24px;line-height:1.4;color:#A9B4C6\">범위 안에서 값을 고른다</p>\n</div>\n</div>\n<div style=\"display:flex;justify-content:center;align-items:center\">\n<x-shape kind=\"arrow-right\" style=\"background:#F2B13C;width:56px;height:28px\"></x-shape>\n</div>\n<div style=\"display:flex;gap:16px;align-items:center;background:#18243A;padding:24px;border-radius:16px\">\n<p style=\"width:48px;font-size:26px;font-weight:700;line-height:1.4;text-align:center;color:#0E1726;background:#F2B13C;padding:6px 0px;border-radius:50%\">2</p>\n<div style=\"display:flex;flex-direction:column;gap:6px\">\n<h3 style=\"font-size:28px;font-weight:700;line-height:1.25;color:#EDEBE4\">백테스트</h3>\n<p style=\"font-size:24px;line-height:1.4;color:#A9B4C6\">과거 데이터로 돌려 본다</p>\n</div>\n</div>\n<div style=\"display:flex;justify-content:center;align-items:center\">\n<x-shape kind=\"arrow-up\" style=\"background:#F2B13C;width:28px;height:56px\"></x-shape>\n</div>\n<div style=\"display:flex;justify-content:center;align-items:center\">\n<svg aria-label=\"가슴 화면에 오르는 차트를 띄운 로봇\" width=\"168\" height=\"168\" viewBox=\"0 0 168 168\">\n<g transform=\"scale(0.56)\">\n<line x1=\"150\" y1=\"40\" x2=\"150\" y2=\"18\" stroke=\"#A9B4C6\" stroke-width=\"6\" stroke-linecap=\"round\"/>\n<circle cx=\"150\" cy=\"16\" r=\"10\" fill=\"#F2B13C\"/>\n<rect x=\"70\" y=\"40\" width=\"160\" height=\"110\" rx=\"28\" fill=\"#EDEBE4\"/>\n<rect x=\"88\" y=\"62\" width=\"124\" height=\"60\" rx=\"18\" fill=\"#0E1726\"/>\n<circle cx=\"122\" cy=\"92\" r=\"12\" fill=\"#F2B13C\"/>\n<circle cx=\"178\" cy=\"92\" r=\"12\" fill=\"#F2B13C\"/>\n<rect x=\"52\" y=\"78\" width=\"18\" height=\"36\" rx=\"8\" fill=\"#A9B4C6\"/>\n<rect x=\"230\" y=\"78\" width=\"18\" height=\"36\" rx=\"8\" fill=\"#A9B4C6\"/>\n<rect x=\"132\" y=\"150\" width=\"36\" height=\"16\" fill=\"#A9B4C6\"/>\n<rect x=\"60\" y=\"166\" width=\"180\" height=\"120\" rx=\"26\" fill=\"#EDEBE4\"/>\n<rect x=\"82\" y=\"186\" width=\"136\" height=\"80\" rx=\"12\" fill=\"#0E1726\"/>\n<polyline points=\"94,250 118,232 140,240 166,212 188,220 206,198\" fill=\"none\" stroke=\"#F2B13C\" stroke-width=\"6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n<circle cx=\"206\" cy=\"198\" r=\"7\" fill=\"#F2B13C\"/>\n<rect x=\"28\" y=\"180\" width=\"32\" height=\"76\" rx=\"14\" fill=\"#A9B4C6\"/>\n<rect x=\"240\" y=\"180\" width=\"32\" height=\"76\" rx=\"14\" fill=\"#A9B4C6\"/>\n</g>\n</svg>\n</div>\n<div style=\"display:flex;justify-content:center;align-items:center\">\n<x-shape kind=\"arrow-down\" style=\"background:#F2B13C;width:28px;height:56px\"></x-shape>\n</div>\n<div style=\"display:flex;gap:16px;align-items:center;background:#18243A;padding:24px;border-radius:16px\">\n<p style=\"width:48px;font-size:26px;font-weight:700;line-height:1.4;text-align:center;color:#0E1726;background:#F2B13C;padding:6px 0px;border-radius:50%\">4</p>\n<div style=\"display:flex;flex-direction:column;gap:6px\">\n<h3 style=\"font-size:28px;font-weight:700;line-height:1.25;color:#EDEBE4\">기록하고 반복</h3>\n<p style=\"font-size:24px;line-height:1.4;color:#A9B4C6\">기억하고 다시 고른다</p>\n</div>\n</div>\n<div style=\"display:flex;justify-content:center;align-items:center\">\n<x-shape kind=\"arrow-left\" style=\"background:#F2B13C;width:56px;height:28px\"></x-shape>\n</div>\n<div style=\"display:flex;gap:16px;align-items:center;background:#18243A;padding:24px;border-radius:16px\">\n<p style=\"width:48px;font-size:26px;font-weight:700;line-height:1.4;text-align:center;color:#0E1726;background:#F2B13C;padding:6px 0px;border-radius:50%\">3</p>\n<div style=\"display:flex;flex-direction:column;gap:6px\">\n<h3 style=\"font-size:28px;font-weight:700;line-height:1.25;color:#EDEBE4\">점수 매기기</h3>\n<p style=\"font-size:24px;line-height:1.4;color:#A9B4C6\">목표 점수로 채점한다</p>\n</div>\n</div>\n</div>\n</div>\n<div style=\"display:flex;gap:32px\">\n<div style=\"flex:1;display:flex;gap:16px;align-items:center;padding:20px 28px;border:2px solid #2A3A57;border-radius:16px\">\n<svg data-icon=\"Activity\" aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"color:#F2B13C;width:36px;height:36px;flex-shrink:0\"><path d=\"M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2\"/></svg>\n<p style=\"font-size:26px;font-weight:700;line-height:1.4;color:#EDEBE4\">기본 100번 시험</p>\n</div>\n<div style=\"flex:1;display:flex;gap:16px;align-items:center;padding:20px 28px;border:2px solid #2A3A57;border-radius:16px\">\n<svg data-icon=\"Lightning\" aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"color:#F2B13C;width:36px;height:36px;flex-shrink:0\"><path d=\"M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z\"/></svg>\n<p style=\"font-size:26px;font-weight:700;line-height:1.4;color:#EDEBE4\">10개씩 동시에 실행</p>\n</div>\n<div style=\"flex:1;display:flex;gap:16px;align-items:center;padding:20px 28px;border:2px solid #2A3A57;border-radius:16px\">\n<svg data-icon=\"Verified\" aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"color:#F2B13C;width:36px;height:36px;flex-shrink:0\"><path d=\"M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z\"/><path d=\"m9 12 2 2 4-4\"/></svg>\n<p style=\"font-size:26px;font-weight:700;line-height:1.4;color:#EDEBE4\">끝나면 검증 구간에서 다시 확인</p>\n</div>\n</div>\n</section>",
      "notes": "먼저 말부터 정리하겠습니다. 하이퍼파라미터는 전략을 돌리기 전에 사람이 미리 정해 줘야 하는 설정값입니다. 제 전략에서는 이동평균 기간, RSI 기준, 손절 폭 같은 숫자입니다. 라면으로 치면 물의 양과 끓이는 시간입니다. 재료가 같아도 이 값에 따라 맛이 달라지듯, 전략이 같아도 이 값에 따라 수익이 달라집니다. 이 값을 가장 좋은 결과가 나오게 맞추는 일이 하이퍼파라미터 튜닝입니다. 문제는 손으로 하기에는 너무 많다는 점입니다. 값 3개를 10가지씩만 시험해도 10 곱하기 10 곱하기 10, 1,000번을 돌려야 합니다. 그래서 이 일을 로봇에게 맡기는 기능이 하이퍼옵트입니다. 순서는 네 단계입니다. 첫째, 제가 정해 준 범위 안에서 값을 고릅니다. 둘째, 그 값으로 과거 데이터에 백테스트를 돌립니다. 셋째, 결과에 점수를 매깁니다. 점수 기준은 샤프 비율, 소르티노 비율, 칼마 비율, 수익률 나누기 최대 낙폭, 총 수익률 중에서 고를 수 있습니다. 넷째, 결과를 기록하고 다시 첫 단계로 돌아갑니다. 기본 설정으로는 이 과정을 100번 반복하고, 백테스트를 10개씩 동시에 돌려 시간을 줄입니다. 탐색이 끝나면 따로 떼어 둔 검증 구간에서 상위 조합을 다시 돌려, 과거에만 우연히 잘 맞은 값이 아닌지 확인합니다. 그럼 첫 단계에서 값을 어떻게 고르는지 다음 장에서 설명하겠습니다."
    },
    {
      "id": "tpe-path",
      "title": "TPE: 잘된 값 근처를 더 자주 시험하며 최적값을 찾는다",
      "html": "<section id=\"tpe-path\" data-transition=\"fade\" style=\"background:#F5F3EC;color:#0E1726;font-family:'Noto Sans KR', Arial, sans-serif;padding:128px 128px 160px;display:flex;flex-direction:column;justify-content:space-between;gap:24px\">\n<p style=\"font-size:24px;font-weight:700;letter-spacing:2px;color:#8A5D00\">Optuna TPE · 100번의 기록</p>\n<h2 style=\"font-size:60px;font-weight:700;line-height:1.2;color:#0E1726\">TPE: 잘된 값 근처를 더 자주 시험하며 최적값을 찾는다</h2>\n<div style=\"display:flex;gap:28px;align-items:center\">\n<div style=\"display:flex;gap:10px;align-items:center\">\n<div style=\"width:28px;height:20px;background:#F2B13C;border-radius:4px\"></div>\n<p style=\"font-size:24px;line-height:1.4;color:#4A5568\">진할수록 점수가 높은 곳</p>\n</div>\n<div style=\"display:flex;gap:10px;align-items:center\">\n<div style=\"width:28px;height:20px;background:#C3C8D2;border-radius:4px\"></div>\n<p style=\"font-size:24px;line-height:1.4;color:#4A5568\">점수가 낮은 곳</p>\n</div>\n<div style=\"display:flex;gap:10px;align-items:center\">\n<svg aria-label=\"진한 엑스 표시\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\"><path d=\"M 5 5 L 19 19 M 5 19 L 19 5\" fill=\"none\" stroke=\"#0E1726\" stroke-width=\"3\" stroke-linecap=\"round\"/></svg>\n<p style=\"font-size:24px;line-height:1.4;color:#4A5568\">이번 단계에 시험한 값</p>\n</div>\n<div style=\"display:flex;gap:10px;align-items:center\">\n<svg aria-label=\"흐린 엑스 표시\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\"><path d=\"M 5 5 L 19 19 M 5 19 L 19 5\" fill=\"none\" stroke=\"#0E1726\" stroke-opacity=\"0.25\" stroke-width=\"3\" stroke-linecap=\"round\"/></svg>\n<p style=\"font-size:24px;line-height:1.4;color:#4A5568\">앞 단계</p>\n</div>\n<div style=\"display:flex;gap:10px;align-items:center\">\n<svg aria-label=\"흰 동그라미 표시\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\" fill=\"#FFFFFF\" stroke=\"#0E1726\" stroke-width=\"3\"/></svg>\n<p style=\"font-size:24px;line-height:1.4;color:#4A5568\">찾아낸 최고점</p>\n</div>\n</div>\n<div style=\"display:flex;gap:40px;align-items:stretch\">\n<div style=\"width:528px;display:flex;flex-direction:column;gap:10px\">\n<h3 style=\"font-size:28px;font-weight:700;line-height:1.25;color:#0E1726\">1~20번 · 무작위로 흩뿌린다</h3>\n<svg aria-label=\"1번부터 20번까지: 시험한 값 20개가 지형 전체에 흩어져 있다\" width=\"528\" height=\"360\" viewBox=\"0 0 528 360\">\n<rect x=\"4\" y=\"4\" width=\"520\" height=\"352\" rx=\"8\" fill=\"#FBFAF6\" stroke=\"#0E1726\" stroke-width=\"2\"/>\n<ellipse cx=\"51\" cy=\"180\" rx=\"44\" ry=\"80\" fill=\"#8E97A8\" fill-opacity=\"0.22\"/><ellipse cx=\"51\" cy=\"180\" rx=\"24\" ry=\"44\" fill=\"#8E97A8\" fill-opacity=\"0.35\"/>\n<ellipse cx=\"441\" cy=\"180\" rx=\"70\" ry=\"58\" fill=\"#F2B13C\" fill-opacity=\"0.2\"/><ellipse cx=\"441\" cy=\"180\" rx=\"38\" ry=\"32\" fill=\"#F2B13C\" fill-opacity=\"0.3\"/>\n<ellipse cx=\"254\" cy=\"173\" rx=\"150\" ry=\"89\" fill=\"#F2B13C\" fill-opacity=\"0.2\"/><ellipse cx=\"254\" cy=\"173\" rx=\"105\" ry=\"62\" fill=\"#F2B13C\" fill-opacity=\"0.3\"/><ellipse cx=\"254\" cy=\"173\" rx=\"65\" ry=\"38\" fill=\"#F2B13C\" fill-opacity=\"0.45\"/><ellipse cx=\"254\" cy=\"173\" rx=\"32\" ry=\"19\" fill=\"#F2B13C\" fill-opacity=\"0.8\"/>\n<path d=\"M194 16l10 10m0 -10l-10 10M380 140l10 10m0 -10l-10 10M80 296l10 10m0 -10l-10 10M29 46l10 10m0 -10l-10 10M312 102l10 10m0 -10l-10 10M10 10l10 10m0 -10l-10 10M432 276l10 10m0 -10l-10 10M94 286l10 10m0 -10l-10 10M157 166l10 10m0 -10l-10 10M224 248l10 10m0 -10l-10 10M317 302l10 10m0 -10l-10 10M151 222l10 10m0 -10l-10 10M236 75l10 10m0 -10l-10 10M103 170l10 10m0 -10l-10 10M307 335l10 10m0 -10l-10 10M315 291l10 10m0 -10l-10 10M33 17l10 10m0 -10l-10 10M501 66l10 10m0 -10l-10 10M157 317l10 10m0 -10l-10 10M355 196l10 10m0 -10l-10 10\" fill=\"none\" stroke=\"#0E1726\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n</svg>\n<p style=\"font-size:24px;line-height:1.4;color:#4A5568\">어디가 높은지 몰라서 전체를 훑는다</p>\n</div>\n<div style=\"width:528px;display:flex;flex-direction:column;gap:10px\">\n<h3 